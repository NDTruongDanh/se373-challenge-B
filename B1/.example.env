# Copy to .env and fill in your key.
# The harness talks to the opencode Go inference endpoint directly
# (https://opencode.ai/docs/go/#endpoints), OpenAI-compatible.
# Auth = Go API key (/connect in the TUI, then paste). Routing/caching =
# client-chosen x-opencode-session header (auto-generated per run unless
# OPENCODE_SESSION_ID is set, e.g. inside an opencode session).

# Go API key
OPENCODE_API_KEY=
# Direct Go inference base URL (model muse-spark lives at .../openai/v1/responses)
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Fallback: plain OpenAI key (used only if OPENCODE_API_KEY is empty)
OPENAI_API_KEY=

# Model for the agent loop
AGENT_MODEL=muse-spark-1.3-contributor
# Cheaper/faster model for the compaction summary step (may be the same)
COMPACT_MODEL=muse-spark-1.3-contributor

# Compaction trigger budget (input tokens). Lower = compacts sooner (good for demo).
TOKEN_BUDGET=8000
